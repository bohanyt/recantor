FROM python:3.13-slim AS schema

RUN pip install --no-cache-dir uv==0.10.0
WORKDIR /api
COPY apps/api/pyproject.toml apps/api/uv.lock ./
COPY apps/api/src ./src
COPY apps/api/alembic.ini ./
COPY apps/api/alembic ./alembic
RUN uv sync --frozen --no-dev
RUN .venv/bin/python -c 'import json; from recantor.main import app; open("/tmp/openapi.json", "w", encoding="utf-8").write(json.dumps(app.openapi(), sort_keys=True))'

FROM node:24-alpine AS build

ARG RECANTOR_VERSION=dev
ARG RECANTOR_REVISION=unknown
ARG VITE_API_BASE_URL=http://localhost:8000

ENV OPENAPI_INPUT=/tmp/openapi.json \
    VITE_APP_NAME=Recantor \
    VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_RECORDING_REQUEST_TIMEOUT_MS=5000

RUN corepack enable && corepack prepare pnpm@11.7.0 --activate

WORKDIR /app
COPY apps/web/package.json apps/web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY apps/web/ ./
COPY --from=schema /tmp/openapi.json /tmp/openapi.json
RUN pnpm generate:api && pnpm build

FROM nginx:1.29-alpine

ARG RECANTOR_VERSION=dev
ARG RECANTOR_REVISION=unknown

LABEL org.opencontainers.image.title="Recantor Web" \
      org.opencontainers.image.description="Recantor prebuilt web runtime" \
      org.opencontainers.image.source="https://github.com/bohanyt/recantor" \
      org.opencontainers.image.version="$RECANTOR_VERSION" \
      org.opencontainers.image.revision="$RECANTOR_REVISION"

COPY apps/web/nginx.release.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 5173
HEALTHCHECK --interval=10s --timeout=3s --retries=6 CMD wget -qO- http://127.0.0.1:5173/ >/dev/null || exit 1
