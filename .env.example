# Recantor development configuration template.
# Copy to .env locally. Never commit real credentials.

# Required for live and uploaded-media speech-to-text in the development stack.
# Keep this server-side; Compose forwards it only to API/STT worker services.
GROQ_API_KEY=

# Direct local development defaults. Docker Compose supplies container hostnames internally.
RECANTOR_ENV=development
VITE_APP_NAME=Recantor
VITE_API_BASE_URL=http://localhost:8000
VITE_RECORDING_REQUEST_TIMEOUT_MS=5000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://recantor:recantor@localhost:5432/recantor
REDIS_URL=redis://localhost:6379/0
AUDIO_STORAGE_PATH=./data/audio
RECORDING_HEARTBEAT_TIMEOUT_SECONDS=20
RECORDING_MAX_CHUNK_BYTES=16777216

# Resumable existing-recording uploads.
UPLOAD_MAX_BYTES=5368709120
UPLOAD_MAX_DURATION_SECONDS=43200
UPLOAD_CAPABILITY_TTL_SECONDS=86400
UPLOAD_TUS_STORAGE_PREFIX=uploads/tus
TUS_PUBLIC_ENDPOINT=http://localhost:1080/files/

# Implemented Groq adapter overrides. Leave defaults unless you are intentionally testing them.
# GROQ_STT_ENDPOINT=https://api.groq.com/openai/v1/audio/transcriptions
# GROQ_STT_MODEL=whisper-large-v3-turbo
# GROQ_STT_TIMEOUT_SECONDS=30

# Durable STT scheduler tuning. Normal setup should not need to change these defaults.
STT_QUEUE_NAME=stt-live
STT_UPLOAD_QUEUE_NAME=stt-upload
STT_CLAIM_LEASE_SECONDS=60
STT_MAX_ATTEMPTS=5
STT_RETRY_BASE_SECONDS=2
STT_RETRY_MAX_SECONDS=60
STT_CONFIGURATION_RETRY_SECONDS=300
STT_RECONCILE_INTERVAL_SECONDS=1
STT_RECONCILE_BATCH_SIZE=100
STT_UPLOAD_RECONCILE_BATCH_SIZE=32
STT_RECONCILE_PER_SESSION_LIMIT=2
STT_UPLOAD_RECONCILE_PER_SESSION_LIMIT=2
STT_DISPATCH_REENQUEUE_SECONDS=15

# Uploaded-media processing tuning. One dedicated media slot is the conservative alpha default.
MEDIA_QUEUE_NAME=media-upload
MEDIA_CLAIM_LEASE_SECONDS=1200
MEDIA_MAX_ATTEMPTS=3
MEDIA_RETRY_BASE_SECONDS=5
MEDIA_RECONCILE_INTERVAL_SECONDS=1
MEDIA_PROBE_TIMEOUT_SECONDS=20
MEDIA_NORMALIZE_TIMEOUT_SECONDS=900
MEDIA_SUBPROCESS_OUTPUT_LIMIT_BYTES=262144

LOG_LEVEL=INFO
