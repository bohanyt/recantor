# Recantor development configuration template.
# Copy to .env locally and provide real secrets there. Never commit real credentials.

RECANTOR_ENV=development

# Web/API
VITE_API_BASE_URL=http://localhost:8000
PUBLIC_BASE_URL=http://localhost:5173

# Durable structured state
DATABASE_URL=postgresql+psycopg://recantor:recantor@postgres:5432/recantor

# Ephemeral coordination / background jobs
REDIS_URL=redis://redis:6379/0

# Audio storage
AUDIO_STORAGE_BACKEND=filesystem
AUDIO_STORAGE_PATH=/data/audio

# Resumable uploads (planned)
TUS_BASE_URL=http://localhost:1080/files/

# Speech-to-text (planned; leave secret blank in committed files)
STT_PRIMARY_PROVIDER=groq
STT_FALLBACK_PROVIDER=local
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
LOCAL_STT_BASE_URL=http://stt-local:8000

# Logging
LOG_LEVEL=INFO
